{% extends 'elements/list.html.twig' %}

{% set nb = nb_status %}

{% set columns = [
    {
        'label': '#', order: constant('GaletteObjectsLend\\Repository\\Status::ORDERBY_ID'),
        'collapse': true
    },
    {'label': _T("Status", "objectslend"), order: constant('GaletteObjectsLend\\Repository\\Status::ORDERBY_NAME')},
    {
        'label': _T("Active", "objectslend"), order: constant('GaletteObjectsLend\\Repository\\Status::ORDERBY_ACTIVE'),
        'collapse': true
    },
    {
        'label': _T("Stock", "objectslend"), order: constant('GaletteObjectsLend\\Repository\\Status::ORDERBY_STOCK'),
        'collapse': true
    },
    {
        'label': _T("Days for rent", "objectslend"), order: constant('GaletteObjectsLend\\Repository\\Status::ORDERBY_RENTDAYS'),
        'collapse': true
    }
] %}

{% set form = {
    'order': {
        'name': "objectslend_statuses"
    }
} %}

{% import "macros.twig" as macros %}
{% import "@PluginGaletteObjectslend/macros.twig" as lend %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%1$s status", "%1$s statuses", nb, "objectslend")|format(nb),
        'route': {
            'name': 'objectslend_filter_statuses'
        }
    } %}
    {{ parent() }}
{% endblock %}

{% block infoline_actions %}
    <a
            class="ui tiny labeled icon button"
            href="{{ url_for("objectslend_status_add") }}"
    >
        <i class="plus circle green icon" aria-hidden="true"></i>
        {{ _T("Add a status", "objectslend") }}
    </a>
{% endblock %}

{% block search %}
    <form action="{{ url_for("objectslend_filter_statuses") }}" method="post" id="filtre" class="ui form filters">
        <div class="ui secondary yellow segment">
            {{ lend.searchField(filters.filter_str) }}
            <div class="two fields">
                {{ lend.triStateFilter('active_filter', 'active', _T("Active:", "objectslend"), filters.active_filter, {dc: constant('GaletteObjectsLend\\Repository\\Status::ALL'), yes: constant('GaletteObjectsLend\\Repository\\Status::ACTIVE'), no: constant('GaletteObjectsLend\\Repository\\Status::INACTIVE')}) }}
                {{ lend.triStateFilter('stock_filter', 'stock', _T("In stock:", "objectslend"), filters.stock_filter, {dc: constant('GaletteObjectsLend\\Repository\\Status::DC_STOCK'), yes: constant('GaletteObjectsLend\\Repository\\Status::IN_STOCK'), no: constant('GaletteObjectsLend\\Repository\\Status::OUT_STOCK')}) }}
            </div>
            <div class="fields last-child">
                {{ lend.filterButtons('sixteen wide') }}
            </div>
        </div>
    </form>
{% endblock %}

{% block body %}
    {% for status in statuses %}
        <tr class="{% if loop.index is odd %}even{% else %}odd{% endif %}">
            <td class="collapsing" data-scope="id">
                {{ status.getId() }}
            </td>
            <td data-col-label="{{ _T("Status", "objectslend") }}">
                {{ status.getText() }}
            </td>
            <td class="center collapsing" data-col-label="{{ _T("Active", "objectslend") }}">
                {% if status.isActive() %}
                    <i class="check circle green icon tooltip" data-html="{{ _T("Active", "objectslend") }}"></i>
                    <span class="visually-hidden">{{ _T("Active", "objectslend") }}</span>
                {% else %}
                    <i class="times circle red icon tooltip" data-html="{{ _T("Inactive", "objectslend") }}"></i>
                    <span class="visually-hidden">{{ _T("Inactive", "objectslend") }}</span>
                {% endif %}
            </td>
            <td class="center collapsing" data-col-label="{{ _T("Stock", "objectslend") }}">
                {% if status.isInStock() %}
                    <i class="warehouse green icon tooltip" data-html="{{ _T("In stock", "objectslend") }}"></i>
                    <span class="visually-hidden">{{ _T("In stock", "objectslend") }}</span>
                {% else %}
                    <i class="hand holding orange icon tooltip" data-html="{{ _T("Not in stock", "objectslend") }}"></i>
                    <span class="visually-hidden">{{ _T("Not in stock", "objectslend") }}</span>
                {% endif %}
            </td>
            <td class="collapsing" data-col-label="{{ _T("Days for rent", "objectslend") }}">
                {% if status.getRentDayNumber() %}
                    {{ _T("%days days", "objectslend")|replace({'%days': status.getRentDayNumber()}) }}
                {% else %}
                    -
                {% endif %}
            </td>
            <td class="center actions_row collapsing">
                {% set actions = [
                    {
                        'label': _T("Edit %status", "objectslend")|replace({'%status': status.getText()}),
                        'route': {
                            'name': 'objectslend_status_edit',
                            'args': {'id': status.getId()}
                        },
                        'icon': 'edit'
                    },
                    {
                        'label': _T("Remove %status from database", "objectslend")|replace({'%status': status.getText()}),
                        'route': {
                        'name': 'objectslend_remove_status',
                            'args': {'id': status.getId()}
                        },
                        'icon': 'trash red',
                        'extra_class': 'delete'
                    }
                ] %}

                {% for action in actions %}
                    {{ macros.drawListAction(action.label, action.route, action.icon, action.extra_class ?? '') }}
                {% endfor %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="{{ columns_count }}" class="emptylist">{{ _T("No status has been found", "objectslend") }}</td></tr>
    {% endfor %}
{% endblock %}
