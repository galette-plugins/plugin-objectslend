{% extends 'page.html.twig' %}
{% import "@PluginGaletteObjectslend/macros.twig" as lend %}

{% block content %}
<form action="{% if takeorgive == 'take' %}{{ url_for("objectslend_object_dotake", {"id": object.getId()}) }}{% else %}{{ url_for("objectslend_object_doreturn", {"id": object.getId()}) }}{% endif %}" method="post" id="form_take_object" class="ui form info" data-mode="{{ takeorgive }}">
    <div class="ui styled fluid accordion field">
        <div class="active title" role="heading" aria-level="2">
            <i class="icon dropdown" aria-hidden="true"></i>
            {{ _T("Object", "objectslend") }}
        </div>
        <div class="active content field">
            <div class="ui stackable grid">
                <div class="twelve wide column">
                    <table class="ui very basic definition compact collapsing stackable table">
                        <tr>
                            <th scope="row">{{ _T("Name:", "objectslend") }}</th>
                            <td>{{ object.getName() }}</td>
                        </tr>
            {% if lendsprefs.view_description %}
                        <tr>
                            <th scope="row">{{ _T("Description:", "objectslend") }}</th>
                            <td>{{ object.getDescriptionHtml()|raw }}</td>
                        </tr>
            {% endif %}
            {% if lendsprefs.view_serial %}
                        <tr>
                            <th scope="row">{{ _T("Serial number:", "objectslend") }}</th>
                            <td>{{ object.getSerialNumber() }}</td>
                        </tr>
            {% endif %}
            {% if lendsprefs.view_price %}
                        <tr>
                            <th scope="row">{{ _T("Price:", "objectslend") }}</th>
                            <td>{{ object.getPrice()|format_currency('EUR', {}, i18n.getWebID()) }}</td>
                        </tr>
            {% endif %}
            {% if lendsprefs.view_dimension %}
                        <tr>
                            <th scope="row">{{ _T("Dimensions:", "objectslend") }}</th>
                            <td>{% if object.getDimension() != '' %}{{ object.getDimension() }} {{ _T("Cm", "objectslend") }}{% else %}-{% endif %}</td>
                        </tr>
            {% endif %}
            {% if lendsprefs.view_weight %}
                        <tr>
                            <th scope="row">{{ _T("Weight:", "objectslend") }}</th>
                            <td>{% if object.getWeight() %}{{ object.getWeight()|format_number({fraction_digit: 3}, 'decimal', 'default', i18n.getWebID()) }} {{ _T("Kg", "objectslend") }}{% else %}-{% endif %}</td>
                        </tr>
            {% endif %}
                        <tr>
            {% if takeorgive == 'take' and (login.isAdmin() or login.isStaff()) %}
                            <th scope="row"><label for="rent_price">{{ _T("Borrow price:", "objectslend") }}</label></th>
                            <td>
                                <div class="ui right labeled input">
                                    <input type="text" name="rent_price" id="rent_price" value="{{ object.getRentPrice()|number_format(2, '.', '') }}" size="10">
                                    <div class="ui basic label">€</div>
                                </div>
            {% else %}
                            <th scope="row">{{ _T("Borrow price:", "objectslend") }}</th>
                            <td>
                                <input type="hidden" name="rent_price" id="rent_price" value="{{ object.getRentPrice()|number_format(2, '.', '') }}">
                                {{ object.getRentPrice()|format_currency('EUR', {}, i18n.getWebID()) }}
            {% endif %}
                                {% if object.isPricePerDay() %}{{ _T("(per day)", "objectslend") }}{% else %}{{ _T("(at once)", "objectslend") }}{% endif %}
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="four wide right aligned column">
                    {{ lend.thumbnail("object", object.getId(), object.getPicture(), olendsprefs, _T("Object photo", "objectslend")) }}
                </div>
            </div>
        </div>
    </div>

    {% if takeorgive == 'take' %}
        <div class="ui styled fluid accordion field">
            <div class="active title" role="heading" aria-level="2">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Borrow information", "objectslend") }}
            </div>
            <div class="active content">
                {% if login.isAdmin() or login.isStaff() %}
                    {% include 'components/forms/member_dropdown.html.twig' with {
                        'id': 'id_adh',
                        'label': _T("Member:", "objectslend"),
                        'value': login.isSuperAdmin() ? null : login.id,
                        'component_class': 'inline field'
                    } %}
                {% endif %}

                <div class="inline field">
                    {{ lend.statusSelect('status', _T("Status:", "objectslend"), statuses, -1, 'days') }}
                </div>

                <div class="inline field">
                    {% include "components/forms/date.html.twig" with {
                        id: 'expected_return',
                        value: date_forecast,
                        label: _T("Expected return:", "objectslend")
                    } %}
                </div>

                {% if lendsprefs.auto_generate_contribution %}
                <div class="inline field">
                    {% include "components/forms/payment_types.html.twig" with {
                        show_inline: true,
                        current: contribution.payment_type,
                        varname: "payment_type"
                    } %}
                </div>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="ui styled fluid accordion field">
            <div class="active title" role="heading" aria-level="2">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Return information", "objectslend") }}
            </div>
            <div class="active content">
                <div class="inline field">
                    {{ lend.statusSelect('status', _T("Status:", "objectslend"), statuses, -1) }}
                </div>

                <p>
                    <strong>{{ _T("Time:", "objectslend") }}</strong>
                    {{ _T("From %begindate to %enddate", "objectslend")|replace({"%begindate": last_rent.getDateBegin(), "%enddate": "now"|date(_T("Y-m-d"))}) }}
                </p>
                <div>
                    {% include "components/forms/textarea.html.twig" with {
                        id: 'comments',
                        value: '',
                        label: _T("Comments:", "objectslend"),
                        maxlength: 200
                    } %}
                    <span class="exemple"><span id="remaining">200</span> {{ _T("remaining characters", "objectslend") }}</span>
                </div>
            </div>
        </div>
    {% endif %}

    {% if takeorgive == 'take' %}
    <div class="disclaimer center">
        <div class="ui checkbox">
            <input type="checkbox" name="agreement" id="agreement" value="1" required="required"/>
            <label for="agreement">{{ _T("I have read and I agree with terms and conditions", "objectslend") }}</label>
        </div>
        <div id="attach-checkbox" class="ui toggle checkbox">
            <input type="checkbox" name="show_terms" id="show_terms" value="1"/>
            <label for="show_terms">{{ _T("Show terms and conditions", "objectslend") }}</label>
        </div>
        <div id="show_terms_elt" class="">
            <div class="ui info message">
                {{ _T("The items offered for rent are in good condition and verification rental contradictory to their status is at the time of withdrawal. No claims will be accepted after the release of the object. Writing by the store a list of reservation does not exempt the customer checking his retrait. The payment of rent entitles the purchaser to make normal use of the loaned object. If the object is rendered in a degraded state, the seller reserves the right to collect all or part of the security deposit. In case of deterioration of the rented beyond the standard object, a financial contribution will be required for additional cleaning caused. In case of damage, loss or theft of the rented property, the deposit will not be refunded automatically to 'the company as damages pursuant to Article 1152 of the Civil Code and without that it need for any other judicial or extra-judicial formality. In some other cases not listed above and at the discretion of the seller, the deposit check may also be collected in whole or party.", "objectslend") }}
            </div>
        </div>
    </div>
    {% endif %}

    <div class="ui basic center aligned fitted segment">
        <button type="submit" name="valid" class="action ui labeled icon primary button">
            <i class="save icon" aria-hidden="true"></i> {% if takeorgive == 'take' %}{{ _T("Borrow object", "objectslend") }}{% else %}{{ _T("Return object", "objectslend") }}{% endif %}
        </button>
        <input type="hidden" name="mode" value="{% if ajax %}ajax{% endif %}"/>
    </div>
</form>
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
    {% include "elements/js/choose_adh.js.twig" %}
</script>
{% endblock %}
