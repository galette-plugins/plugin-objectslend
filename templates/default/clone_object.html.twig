{% extends 'page.html.twig' %}

{% block content %}
    <form action="{{ url_for('objectslend_object_doclone', {'id': object.getId()}) }}" method="post" class="ui form">
        <div class="ui segment">
            <div class="ui info message">
                <p>{{ _T('A copy of "%1$s" will be created, without its picture nor its lends history.', 'objectslend')|format(object.getName()) }}</p>
            </div>
        </div>
        <div class="ui basic center aligned segment">
            <button type="submit" class="ui labeled icon primary button action">
                <i class="clone icon" aria-hidden="true"></i>
                {{ _T('Duplicate', 'objectslend') }}
            </button>
            <a href="{{ url_for('objectslend_object_edit', {'id': object.getId()}) }}" class="ui button">{{ _T('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
